{
	"name": "@stolyarovmn/dsh-client-ui-schedule-tab",
	"description": "Global Schedule tab for DeepSeek Harness Web: view built-in scheduled reminders across all dialogs and open their source conversations.",
	"version": "0.4.2",
	"author": {
		"name": "Stolyarovmn",
		"url": "https://github.com/Stolyarovmn"
	},
	"contributors": [
		{
			"name": "Stolyarovmn",
			"url": "https://github.com/Stolyarovmn"
		},
		{
			"name": "Qwen 3.8 27B (AI coding agent, via DeepSeek Harness)",
			"url": "https://github.com/QwenLM"
		}
	],
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "node test/scenarios.test.js",
		"test:bundle": "node test/bundle.test.js",
		"test:all": "npm test && npm run test:bundle"
	},
	"files": [
		"lib/index.js",
		"lib/client.js",
		"cordis.patch.yml",
		"README.md",
		"LICENSE",
		"icon.svg"
	],
	"keywords": [
		"dsh",
		"dsh-plugin",
		"deepseek-harness",
		"plugin",
		"client-plugin",
		"schedule",
		"reminders",
		"web-gui"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Stolyarovmn/dsh-schedule-tab.git"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-ui-conversation",
				"@deepseek-ai/dsh-client-ui-primitives",
				"@deepseek-ai/dsh-api-session-controller",
				"@deepseek-ai/dsh-client-ui-layout"
			]
		},
		"catalog": {
			"category": "ui",
			"summary": {
				"en": "Global Schedule tab for built-in DeepSeek Harness reminders across all dialogs.",
				"zh": "在一个全局 Schedule 标签页中查看所有对话里的 DeepSeek Harness 内置提醒。"
			},
			"capabilities": [
				"slots",
				"locale",
				"sessions",
				"layout"
			]
		}
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"icon": "./icon.svg",
	"peerDependencies": {
		"@deepseek-ai/dsh": ">=0.1.5-rc.3 <0.2.0"
	}
}
