{
  "name": "@stolyarovmn/dsh-client-ui-schedule-control-center",
  "description": "DSH 0.1.7-rc.2 Schedule control center: global Host task catalog, filters, notifications, deletion, delivery history, and native task detail navigation.",
  "version": "0.1.0",
  "author": {
    "name": "Stolyarovmn",
    "url": "https://github.com/Stolyarovmn"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/host.test.js && node test/client-contract.test.js",
    "test:bundle": "node test/bundle.test.js && node --check lib/client.js",
    "test:all": "npm test && npm run test:bundle"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "schedule",
    "automation",
    "reminders",
    "web-gui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stolyarovmn/dsh-schedule-tab.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "catalog": {
      "category": "ui",
      "summary": {
        "en": "Control center for DSH rc2 Host Schedule tasks with notifications, history, deletion, and native task details.",
        "zh": "DSH rc2 Host Schedule 任务控制中心：通知、投递历史、删除和原生任务详情。"
      },
      "capabilities": [
        "slots",
        "locale",
        "schedule",
        "sessions",
        "workspace"
      ]
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2"
  }
}
