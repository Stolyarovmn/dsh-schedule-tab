{
	"name": "@maxim/dsh-client-ui-schedule-tab",
	"description": "Web sidebar Schedule tab: a separate left-panel tab with a global, cross-dialog view of every scheduled reminder; each row names its source dialog and opens it in the same tab (read-only; creating, changing and cancelling stays with the chat Schedule tools)",
	"version": "0.2.0",
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "node test/scenarios.test.js"
	},
	"files": [
		"lib/index.js",
		"lib/client.js",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"dsh",
		"deepseek-harness",
		"plugin",
		"client-plugin",
		"schedule",
		"reminders",
		"web-gui"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Stolyarovmn/dsh-schedule-tab.git"
	},
	"dsh": {
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-ui-conversation",
				"@deepseek-ai/dsh-client-ui-primitives",
				"@deepseek-ai/dsh-api-session-controller",
				"@deepseek-ai/dsh-client-ui-layout"
			]
		}
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
